# Copy to .env and edit. SECRET_KEY must be set to a random string before
# anything beyond a local demo.
#
# Every value below has a working default in backend/app/core/config.py, so a
# missing .env is not fatal -- but SECRET_KEY must be changed for anything
# beyond a local demo.

# Signs JWTs and QR handoff tokens. Regenerate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-you-demo-this

# --- tokens -----------------------------------------------------------
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# --- database ---------------------------------------------------------
# Async URL used by the app. Alembic derives its sync URL from this.
DATABASE_URL=sqlite+aiosqlite:///./notevault.db

# --- uploads (FR 1.1 / 1.4) -------------------------------------------
MAX_UPLOAD_MB=25
PREVIEW_PAGES=3

# --- moderation (FR 4.1) ----------------------------------------------
# true  -> listings go live immediately (used during Phase 1)
# false -> listings wait in the admin moderation queue
AUTO_APPROVE_LISTINGS=false

# --- QR handoff (FR 3.3) ----------------------------------------------
QR_TTL_MINUTES=10

# --- rental reminders (FR 3.2) ----------------------------------------
# Hour of day (local, 0-23) the daily reminder job runs.
REMINDER_HOUR=8
# Set false to keep the scheduler out of the way during tests.
ENABLE_SCHEDULER=true

# --- recommendation engine (FR 1.5 / 3.1) -----------------------------
DUPLICATE_TITLE_THRESHOLD=85
PRICE_MIN_SAMPLE=3

# --- dev server -------------------------------------------------------
# Vite dev server origin, allowed through CORS. Comma-separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HOST=0.0.0.0
PORT=8000
