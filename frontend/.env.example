# NoteVault frontend environment.
# Copy to .env.local and edit. Only VITE_-prefixed vars reach the browser.

# Origin of the API. Leave empty for same-origin, which is what you want in
# both supported setups:
#   dev  -- Vite proxies /api and /ws to http://localhost:8000 (vite.config.ts)
#   prod -- Uvicorn serves frontend/dist itself, so the SPA and the API share
#           one origin and one port.
# Set it only when pointing a local SPA at a remote backend, e.g.
#   VITE_API_BASE=http://192.168.1.20:8000
# The /api/v1 prefix is added by src/lib/api.ts -- do not include it here.
VITE_API_BASE=
